# Runtime
NODE_ENV=development
PORT=3000

# Required in production
DATABASE_URL=postgres://postgres:<password>@127.0.0.1:5432/ecommerce-starter
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
PAYLOAD_SECRET=replace-with-a-long-random-secret
PREVIEW_SECRET=replace-with-a-long-random-preview-secret
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Site metadata
COMPANY_NAME="Payload Commerce"
SITE_NAME="Payload Commerce"
TWITTER_CREATOR="@payloadcms"
TWITTER_SITE="https://example.com"

# Email via SMTP / Nodemailer.
# The adapter is free; SMTP provider pricing depends on your provider.
# Required in production because order/account flows send transactional email.
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME="Payload Commerce"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_SKIP_VERIFY=false

# Required in production for persistent media storage.
# Supabase Storage, MinIO, Cloudflare R2, AWS S3, and other S3-compatible providers can be used.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Payments. Keep disabled until a real provider is configured for the project.
PAYMENT_PROVIDER=disabled
NEXT_PUBLIC_PAYMENT_PROVIDER=disabled
NEXT_PUBLIC_PAYMENT_PROVIDER_LABEL="Оплата карткою"

# Generic hosted checkout/webhook adapter.
# Required only when PAYMENT_PROVIDER=external_redirect.
PAYMENT_EXTERNAL_PROVIDER_LABEL="Оплата карткою"
PAYMENT_EXTERNAL_CHECKOUT_URL=https://pay.example.com/checkout
PAYMENT_EXTERNAL_WEBHOOK_SECRET=replace-with-provider-webhook-secret

# Optional legacy Stripe keys. Required only when PAYMENT_PROVIDER=stripe.
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOKS_SIGNING_SECRET=whsec_

# Keep false in production unless you intentionally expose the destructive demo seed action.
ENABLE_SEED_ENDPOINT=false
NEXT_PUBLIC_ENABLE_SEED_BUTTON=false

# Delivery integrations. Keep disabled until credentials are configured.
# Tariffs are not calculated by the starter; delivery cost is charged by carrier tariffs or entered manually.
NOVA_POSHTA_ENABLED=false
NOVA_POSHTA_API_KEY=
UKRPOSHTA_ENABLED=false
UKRPOSHTA_API_BASE_URL=https://www.ukrposhta.ua
UKRPOSHTA_BEARER_TOKEN=
